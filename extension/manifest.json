{
  "manifest_version": 3,
  "name": "Toya Telecom & Computer - BD Govt Auto-Fill",
  "version": "2.0.0",
  "description": "Auto-fills Bangladeshi government and Teletalk job applications by securely fetching structured candidate data from Toya Telecom & Computer server via Developer API Key.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toya Telecom & Computer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/toya_logo.jpg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
